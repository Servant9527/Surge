#!name=智联招聘去广告
#!desc=移除开屏广告、弹窗、职位页面推广和各类横幅推广。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/ZhiLianZhaoPin.png
#!category=去广告
#!loon_version=3.5.1(998)
#!date=2026-10-02 13:57:49

[Rule]
URL-REGEX,"^https:\/\/(ask|cgate)\.zhaopin\.com\/operation\/ad\/",REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/ask\.zhaopin\.com\/plat-zqa-server\/home\/\d\.\d\.\d\/getHomeContents\? 'delpaths([["data","templates",0,"data","banner"]])'

[Map Local]
(?i)^https:\/\/cgate\.zhaopin\.com\/resumeapi\/resumeCheck\/positionDetailBottomTipCheck$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/cgate\.zhaopin\.com\/bdp\/commercial\/queryLinkData$ data-type=text data="" status-code=404

[MITM]
hostname = %APPEND% ask.zhaopin.com, cgate.zhaopin.com

