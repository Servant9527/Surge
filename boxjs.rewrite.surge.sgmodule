#!name=BoxJs
#!desc=http://boxjs.com
#!icon=https://cdn.jsdelivr.net/gh/chavyleung/scripts@master/box/icons/BoxJs.png
#!category=工具

[General]
force-http-engine-hosts = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

[Script]
Rewrite: BoxJs = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),script-path=https://raw.githubusercontent.com/Servant9527/Surge/main/JS%20folder/chavy.boxjs.js, requires-body=true, timeout=120

[MITM]
hostname = %INSERT% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
