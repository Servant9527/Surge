#!name=Local Device Loopback
#!desc=Reflect 10.7.0.1 back to this device for on-device developer tools.
[General]
ipv6-vif = disabled // 官方开发者服务示例要求关掉 VIF 的 IPv6：SideStore 等工具找 10.7.0.1 回环时会忽略带 IPv6 地址的 VPN 接口，写 auto 会让它找不到回环
tun-included-routes = %INSERT% 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
